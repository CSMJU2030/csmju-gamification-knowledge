# frontend (Next.js) — คัดลอกเป็น .env.local (ห้าม commit)

# backend ของ Code Tower — Next ส่งต่อ /api/* และ /auth/login · /auth/callback · /auth/logout ไปที่นี่
# เบราว์เซอร์คุยกับ origin ของหน้าเว็บที่เดียว จึงลงทะเบียน callback_url กับ Core Hub เป็น <หน้าเว็บ>/auth/callback
BACKEND_URL=http://localhost:3002

# หน้าแรกของ Core Hub (ปุ่ม "กลับหน้าหลัก CSMJU" ใน sidebar)
# ใช้ localhost ไม่ใช่ 127.0.0.1 — คุกกี้ของสอง host แยกกัน
# เข้า/ออกจากระบบไม่ต้องตั้งที่นี่: /auth/login และ /auth/logout ของ backend อ่าน CORE_HUB_WEB_URL เอง (สัญญา auth 1.1)
NEXT_PUBLIC_CORE_DASHBOARD_URL=http://localhost:3100/
