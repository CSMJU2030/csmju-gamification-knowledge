# frontend (Next.js) — คัดลอกเป็น .env.local (ห้าม commit)

# backend ของ Code Tower — Next ส่งต่อ /api/* และ /auth/callback ไปที่นี่
BACKEND_URL=http://localhost:3002

# หน้าเข้าสู่ระบบของ Core Hub ที่พาผู้ใช้กลับมาที่ระบบนี้ผ่าน SSO (401 → ไปหน้านี้)
# {subsystem} ถูกแทนด้วย csmju-code-tower
NEXT_PUBLIC_SSO_LOGIN_URL=http://localhost:3000/sso/login?subsystem={subsystem}

# หน้าออกจากระบบของ Core Hub
NEXT_PUBLIC_SSO_LOGOUT_URL=http://localhost:3000/sso/logout

# หน้าแรกของ Core Hub (ปุ่ม "กลับหน้าหลัก CSMJU" ใน sidebar)
NEXT_PUBLIC_CORE_DASHBOARD_URL=http://localhost:3000/
