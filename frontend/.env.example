# frontend (Next.js) — คัดลอกเป็น .env.local (ห้าม commit)

# backend ของ Code Tower — Next ส่งต่อ /api/* และ /auth/callback ไปที่นี่
BACKEND_URL=http://localhost:3002

# หน้าเว็บของ Core Hub อยู่ที่ :3100 (LOCAL_INTEGRATION_GUIDE ข้อ 0) · API/SSO อยู่ที่ :3000
# หน้าเข้าสู่ระบบที่พาผู้ใช้กลับมาที่ระบบนี้ผ่าน SSO (401 → ไปหน้านี้) · {subsystem} ถูกแทนด้วย csmju-code-tower
# path ของหน้า login ตัวจริงยังไม่รู้ (ยังไม่มีสิทธิ์อ่าน csmju-core-hub) — ค่านี้ตรงกับ Core Hub จำลอง
NEXT_PUBLIC_SSO_LOGIN_URL=http://localhost:3100/login?subsystem={subsystem}

# หน้าออกจากระบบของ Core Hub
NEXT_PUBLIC_SSO_LOGOUT_URL=http://localhost:3100/logout?subsystem={subsystem}

# หน้าแรกของ Core Hub (ปุ่ม "กลับหน้าหลัก CSMJU" ใน sidebar)
NEXT_PUBLIC_CORE_DASHBOARD_URL=http://localhost:3100/
