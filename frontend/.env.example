# frontend (Next.js) — คัดลอกเป็น .env.local (ห้าม commit)

# backend ของ Code Tower — Next ส่งต่อ /api/* และ /auth/login · /auth/callback · /auth/logout ไปที่นี่
# เบราว์เซอร์คุยกับ origin ของหน้าเว็บที่เดียว (http://localhost:3213) จึงลงทะเบียน Callback URL กับ Core Hub
# เป็น http://localhost:3213/auth/callback · พอร์ตของทีม: frontend 3213 · backend 4213 (ผู้ดูแล dev server กำหนด)
BACKEND_URL=http://127.0.0.1:4213

# หน้าแรกของ Core Hub (ปุ่ม "กลับหน้าหลัก CSMJU" ใน sidebar) — Core Hub จริง (standards 1.7.0 · standards/docs/connect-core-hub.md)
# ใช้ตัวจำลองในเครื่อง (csmju2030/start-sim.cjs) ให้ตั้งเป็น http://localhost:3100/
# เข้า/ออกจากระบบไม่ต้องตั้งที่นี่: /auth/login และ /auth/logout ของ backend อ่าน CORE_HUB_WEB_URL เอง
# เปิดหน้าเว็บด้วย http://localhost:<พอร์ต> ไม่ใช่ 127.0.0.1 — ต้องตรงกับ Callback URL ที่ลงทะเบียน (คุกกี้ผูกกับชื่อ host)
NEXT_PUBLIC_CORE_DASHBOARD_URL=https://csmju2030.jowave.com/
