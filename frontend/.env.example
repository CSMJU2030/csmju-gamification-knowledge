# frontend (Next.js) — คัดลอกเป็น .env.local (ห้าม commit)

# backend ของ Code Tower — Next ส่งต่อ /api/* และ /auth/callback ไปที่นี่
BACKEND_URL=http://localhost:3002

# หน้าเว็บของ Core Hub อยู่ที่ :3100 (LOCAL_INTEGRATION_GUIDE ข้อ 0) · API/SSO อยู่ที่ :3000
# ใช้ localhost: /api/sso ของ Core Hub พาไปหน้า login ที่ localhost:3100 เสมอ และคุกกี้ของ 127.0.0.1 กับ localhost แยกกัน
# (ถ้าใช้ 127.0.0.1 ผู้เล่นที่ login ค้างไว้จะถูกพาไปหน้าแรกของ Core Hub แทนที่จะกลับมาที่นี่)

# 401 → ไปหน้านี้ · {subsystem} ถูกแทนด้วย csmju-gamification-knowledge
# /api/sso/<subsystem> ของ Core Hub ขอ handoff แล้วส่งกลับมาที่ /auth/callback ของเรา
# (ยังไม่ login ที่ Core Hub จะผ่าน /login?next=… ก่อน แล้วกลับมาเอง)
NEXT_PUBLIC_SSO_LOGIN_URL=http://localhost:3100/api/sso/{subsystem}

# ปุ่ม "ออกจากระบบ": ลบ session ของระบบนี้ (DELETE /api/v1/sessions/current) แล้วไปหน้านี้
# session ของ Core Hub ไม่แตะ — ออกจาก Core Hub ด้วยปุ่มของ Core Hub เอง (สัญญา 1.0 ยังไม่มี SSO logout)
NEXT_PUBLIC_SSO_LOGOUT_URL=http://localhost:3100/

# หน้าแรกของ Core Hub (ปุ่ม "กลับหน้าหลัก CSMJU" ใน sidebar)
NEXT_PUBLIC_CORE_DASHBOARD_URL=http://localhost:3100/
