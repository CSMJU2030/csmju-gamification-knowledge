# ---------------------------------------------------------------------------
# CSMJU2030 subsystem - ตัวอย่าง environment
# คัดลอกเป็น .env "ก่อน" รัน pnpm install  (ห้าม commit .env)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3002

# ฐานข้อมูลของ subsystem นี้เท่านั้น - ห้ามชี้ไปที่ core_hub
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_tower_db

# Core Hub (ผู้ให้ identity)
CORE_HUB_URL=http://localhost:3000
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json

# สัญญาที่ตรึงไว้ - ห้ามเปลี่ยนค่าเหล่านี้เอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของ subsystem - ต้องตรงกับ name ใน Subsystem Registry
SUBSYSTEM_ID=csmju-code-tower

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5

# ถ้าตั้งไว้ GET /auth/callback จะพาไปหน้านี้ (302) หลังตั้ง session แล้ว — ว่าง = ตอบ JSON
# หน้าเว็บของ Code Tower (frontend) รันที่ :3003 — conformance ยอมรับทั้ง 200 และ 302
SSO_SUCCESS_REDIRECT=http://localhost:3003/
